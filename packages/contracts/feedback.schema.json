{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daren.design/schemas/distill/feedback.schema.json",
  "title": "C5 Feedback and Resume",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "stageRunId", "baseRevision", "inputArtifactRef", "feedbackType", "request", "effectScope", "invalidatedReportRefs", "resultRef", "nextAction"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "jobId": { "type": "string", "minLength": 1 },
    "stageRunId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "integer", "minimum": 1 },
    "inputArtifactRef": { "$ref": "common.schema.json#/$defs/ref" },
    "feedbackType": { "enum": ["implementation-fix", "target-change", "source-evidence"] },
    "request": { "type": "string", "minLength": 1 },
    "effectScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/ref" } },
    "newTargetRef": { "$ref": "common.schema.json#/$defs/ref" },
    "invalidatedReportRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ref" } },
    "resultRef": { "oneOf": [ { "$ref": "common.schema.json#/$defs/ref" }, { "type": "null" } ] },
    "nextAction": { "enum": ["resume", "reaudit", "redissect", "review", "blocked", "done"] }
  },
  "allOf": [
    { "if": { "properties": { "feedbackType": { "const": "source-evidence" } } }, "then": { "required": ["evidenceRefs"] } },
    { "if": { "properties": { "feedbackType": { "const": "target-change" } } }, "then": { "required": ["newTargetRef"] } }
  ]
}
