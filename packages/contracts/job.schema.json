{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daren.design/schemas/distill/job.schema.json",
  "title": "C1 Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "versions", "operation", "invocationOrigin", "canonicalSkillId", "compatibilityMode", "requestedActions", "resolvedStages", "scope", "budget", "repairPolicy", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "core", "plugin"],
      "properties": { "schema": { "const": "1.0.0" }, "core": { "type": "string", "minLength": 1 }, "plugin": { "type": "string", "minLength": 1 } }
    },
    "operation": { "enum": ["run", "inspect", "audit", "optimize"] },
    "invocationOrigin": { "enum": ["explicit-skill", "natural-language", "legacy-skill", "cli", "api"] },
    "canonicalSkillId": { "enum": ["ui-decomposer", "ui-replica-engine", "design-system-adapter", "ui-audit-repair", "direct-cli"] },
    "compatibilityMode": { "enum": ["canonical", "legacy-projected"] },
    "requestedActions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/userAction" } },
    "resolvedStages": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/productionStage" } },
    "sourceRef": { "$ref": "common.schema.json#/$defs/ref" },
    "captureRef": { "$ref": "common.schema.json#/$defs/ref" },
    "blueprintRef": { "$ref": "common.schema.json#/$defs/ref" },
    "assetRef": { "$ref": "common.schema.json#/$defs/ref" },
    "subjectRef": { "$ref": "common.schema.json#/$defs/ref" },
    "profile": { "enum": ["common", "source-fidelity", "design-adaptation", "blueprint-readiness"] },
    "inspectionMode": { "enum": ["audit-only", "repair"] },
    "repairScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scope": { "$ref": "common.schema.json#/$defs/scope" },
    "budget": { "type": "integer", "minimum": 0, "maximum": 3 },
    "repairPolicy": { "enum": ["none", "scoped-auto"] },
    "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "run" } } },
      "then": { "anyOf": [ { "required": ["sourceRef"] }, { "required": ["captureRef"] }, { "required": ["blueprintRef"] }, { "required": ["assetRef"] } ] }
    },
    {
      "if": { "properties": { "operation": { "enum": ["inspect", "audit", "optimize"] } } },
      "then": { "required": ["subjectRef", "profile"] }
    },
    {
      "if": { "required": ["inspectionMode"], "properties": { "inspectionMode": { "const": "repair" } } },
      "then": { "required": ["repairScope"], "properties": { "repairPolicy": { "const": "scoped-auto" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "audit" } } },
      "then": { "properties": { "repairPolicy": { "const": "none" } } }
    }
  ]
}
