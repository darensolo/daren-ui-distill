{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daren.design/schemas/distill/publication-receipt.schema.json",
  "title": "PublicationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "assetRef", "registrationReceiptRef", "projectionRef", "route", "previewRoute", "visibility", "deploymentStatus", "files", "approvalRef", "rollback", "digest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "publication-receipt" },
    "assetRef": { "$ref": "common.schema.json#/$defs/ref" },
    "registrationReceiptRef": { "$ref": "common.schema.json#/$defs/ref" },
    "projectionRef": { "$ref": "common.schema.json#/$defs/ref" },
    "route": { "type": "string", "pattern": "^/(?:[a-z][a-z0-9-]*/)+$" },
    "previewRoute": { "type": "string", "pattern": "^/(?:[a-z][a-z0-9-]*/)*[a-z][a-z0-9-]*\\.html$" },
    "visibility": { "enum": ["listed", "unlisted"] },
    "deploymentStatus": { "const": "not-requested" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "digest"],
        "properties": {
          "relativePath": { "$ref": "common.schema.json#/$defs/relativePath" },
          "digest": { "$ref": "common.schema.json#/$defs/digest" }
        }
      }
    },
    "approvalRef": { "$ref": "common.schema.json#/$defs/ref" },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "targetRoot"],
      "properties": {
        "strategy": { "const": "remove-site-projection" },
        "targetRoot": { "$ref": "common.schema.json#/$defs/relativePath" }
      }
    },
    "digest": { "$ref": "common.schema.json#/$defs/digest" }
  }
}
