{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daren.design/schemas/distill/stage-execution.schema.json",
  "title": "C8 StageExecution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "chainId", "requestedActions", "resolvedStages", "stageRuns", "status", "resumePoint", "remainingBudget"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "chainId": { "type": "string", "minLength": 1 },
    "requestedActions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/userAction" } },
    "resolvedStages": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/productionStage" } },
    "stageRuns": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "inputRefs", "outputRefs", "reportRefs", "status", "effectReceipts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "common.schema.json#/$defs/productionStage" },
          "inputRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ref" } },
          "outputRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ref" } },
          "reportRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ref" } },
          "status": { "enum": ["succeeded", "failed", "blocked", "unsupported", "cancelled", "skipped"] },
          "effectReceipts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ref" } }
        }
      }
    },
    "status": { "enum": ["completed", "partial", "failed", "blocked", "unsupported", "cancelled"] },
    "resumePoint": { "oneOf": [ { "$ref": "common.schema.json#/$defs/productionStage" }, { "type": "null" } ] },
    "remainingBudget": { "type": "integer", "minimum": 0, "maximum": 3 }
  }
}
