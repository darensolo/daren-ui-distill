{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daren.design/schemas/distill/authorization.schema.json",
  "title": "DeliveryAuthorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "revision", "approved", "capability", "targetRoot", "subjectId", "subjectRevision", "inputDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "authorization" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "approved": { "const": true },
    "capability": { "enum": ["library-write", "site-write"] },
    "targetRoot": { "$ref": "common.schema.json#/$defs/relativePath" },
    "subjectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$" },
    "subjectRevision": { "type": "integer", "minimum": 1 },
    "inputDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "expiresAt": { "type": "string", "minLength": 1 }
  }
}
