{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daren.design/schemas/distill/asset-package.schema.json",
  "title": "C3 AssetPackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "revision", "variant", "level", "deliveryStatus", "files", "exports", "dependencies", "props", "states", "intents", "rights"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "variant": { "enum": ["source-replica", "adapted"] },
    "level": { "enum": ["L2", "L3", "recipe"] },
    "deliveryStatus": { "enum": ["preview-ready", "delivered"] },
    "files": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["relativePath", "digest"], "properties": { "relativePath": { "$ref": "common.schema.json#/$defs/relativePath" }, "digest": { "$ref": "common.schema.json#/$defs/digest" } } }
    },
    "exports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "props": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "states": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "intents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rights": { "enum": ["allowed", "restricted", "unknown", "prohibited"] },
    "blueprintRef": { "oneOf": [ { "$ref": "common.schema.json#/$defs/ref" }, { "type": "null" } ] },
    "parentArtifactRef": { "$ref": "common.schema.json#/$defs/ref" },
    "targetRef": { "$ref": "common.schema.json#/$defs/ref" },
    "mapping": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
  },
  "allOf": [
    { "if": { "properties": { "variant": { "const": "source-replica" } } }, "then": { "required": ["blueprintRef"], "properties": { "blueprintRef": { "$ref": "common.schema.json#/$defs/ref" } } } },
    { "if": { "properties": { "variant": { "const": "adapted" } } }, "then": { "required": ["blueprintRef", "parentArtifactRef", "targetRef", "mapping"] } }
  ]
}
