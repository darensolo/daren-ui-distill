{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daren.design/schemas/distill/registration-receipt.schema.json",
  "title": "RegistrationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "assetRef", "sourceRef", "registryRef", "publicEntry", "files", "approvalRef", "rollback", "digest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "registration-receipt" },
    "assetRef": { "$ref": "common.schema.json#/$defs/ref" },
    "sourceRef": { "$ref": "common.schema.json#/$defs/ref" },
    "registryRef": { "$ref": "common.schema.json#/$defs/ref" },
    "publicEntry": { "type": "string", "pattern": "^\\./[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "digest"],
        "properties": {
          "relativePath": { "$ref": "common.schema.json#/$defs/relativePath" },
          "digest": { "$ref": "common.schema.json#/$defs/digest" }
        }
      }
    },
    "approvalRef": { "$ref": "common.schema.json#/$defs/ref" },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "targetRoot", "projectionCommand"],
      "properties": {
        "strategy": { "const": "remove-registration-and-rebuild" },
        "targetRoot": { "$ref": "common.schema.json#/$defs/relativePath" },
        "projectionCommand": { "type": "string", "minLength": 1 }
      }
    },
    "digest": { "$ref": "common.schema.json#/$defs/digest" }
  }
}
