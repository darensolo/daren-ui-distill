{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daren.design/schemas/ui-distill/adapter-manifest.schema.json",
  "title": "Design Asset Registrar Host Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "host",
    "allowedCapabilities",
    "evidenceRoot",
    "forbiddenCapabilities"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "allowedCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "evidenceRoot": {
      "type": "string",
      "minLength": 1
    },
    "forbiddenCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/forbiddenCapability"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": [
        "tokens",
        "registry",
        "conformance",
        "renderedHarness",
        "evidenceStore",
        "docs",
        "agentSkills"
      ]
    },
    "forbiddenCapability": {
      "type": "string",
      "enum": [
        "externalBusinessSystems",
        "privateManualQueue",
        "localHiddenService"
      ]
    }
  }
}
