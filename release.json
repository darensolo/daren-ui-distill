{
  "schemaVersion": "1.0.0",
  "toolId": "ui-distiller",
  "displayName": "UI Distiller",
  "version": "0.3.0",
  "contracts": {
    "schema": "1.0.2",
    "core": "0.3.0",
    "plugin": "0.3.0"
  },
  "runtime": {
    "moduleFormat": "esm",
    "node": ">=24.20 <26",
    "operatingSystems": ["darwin"],
    "architectures": ["arm64", "x64"]
  },
  "supportedSources": {
    "installed-app": { "status": "supported", "formats": ["codex-macos-asar"] },
    "application-archive": { "status": "supported", "formats": ["codex-macos-asar"] },
    "asset-directory": { "status": "supported", "formats": ["declared-esm-asset"] },
    "evidence-bundle": { "status": "supported", "formats": ["static", "screenshot", "accessibility", "interaction", "computed-style"] },
    "web-url": { "status": "unsupported", "reason": "contract placeholder; DH05 MVP does not claim generic web capture" }
  },
  "actions": ["dissect", "replicate", "adapt", "register", "publish", "inspect"],
  "productionStages": ["dissect", "replicate", "adapt", "register", "publish"],
  "ports": {
    "host": { "version": "1.0.0", "status": "supported-local-distributions", "targets": ["codex-desktop", "qoder-ide"] },
    "library": { "version": "1.0.0", "status": "supported-local-folder-component", "effects": true, "requiresApproval": "library-write" },
    "site": { "version": "1.0.0", "status": "supported-local-folder-projection", "effects": true, "requiresApproval": "site-write" }
  },
  "limits": {
    "repairRoundsPerJob": 3,
    "archiveResourceBytes": 1073741824
  },
  "security": {
    "sourceMutation": false,
    "executeSourceScripts": false,
    "telemetryService": false,
    "libraryWrite": "explicit-approval-only",
    "siteWrite": "explicit-approval-only",
    "publicDeployment": false,
    "untrustedPreviewPolicy": "fail-closed-without-isolation"
  }
}
